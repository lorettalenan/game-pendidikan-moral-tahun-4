<!DOCTYPE html>
<html lang="ms">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Super Match-3 Pendidikan Moral Tahun 4 (150 Tahap)</title>
    <style>
        :root {
            --primary: #ff7675;
            --secondary: #74b9ff;
            --success: #55efc4;
            --warning: #ffeaa7;
            --dark: #2d3436;
            --light: #f5f6fa;
            --purple: #a29bfe;
            --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
        }

        body {
            font-family: var(--font-family);
            background: linear-gradient(135deg, #ffeaa7 0%, #a29bfe 100%);
            color: var(--dark);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow-x: hidden;
        }

        #game-container {
            width: 100%;
            max-width: 480px;
            height: 100vh;
            max-height: 850px;
            background: white;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            border-radius: 16px;
        }

        .screen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: none;
            flex-direction: column;
            padding: 15px;
            z-index: 10;
        }

        .screen.active {
            display: flex;
        }

        /* Top Bar */
        .top-bar {
            background: linear-gradient(135deg, #6c5ce7, #a29bfe);
            color: white;
            padding: 10px;
            border-radius: 12px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 4px;
            font-size: 12px;
            font-weight: bold;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
            margin-bottom: 8px;
        }

        .top-bar div {
            display: flex;
            align-items: center;
            gap: 4px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        /* Start Screen */
        #start-screen {
            background: linear-gradient(135deg, #ff7675 0%, #6c5ce7 100%);
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 30px;
        }

        .logo-area {
            font-size: 70px;
            margin-bottom: 15px;
            animation: bounce 2s infinite;
        }

        h1 {
            font-size: 28px;
            color: #fff;
            margin-bottom: 5px;
            text-shadow: 2px 2px rgba(0,0,0,0.3);
        }

        h2 {
            font-size: 16px;
            color: #ffeaa7;
            margin-bottom: 40px;
            font-weight: 600;
        }

        .input-group {
            width: 100%;
            margin-bottom: 25px;
        }

        input[type="text"] {
            width: 90%;
            padding: 14px;
            border: 3px solid #ffeaa7;
            border-radius: 25px;
            font-size: 16px;
            text-align: center;
            outline: none;
            font-weight: bold;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        }

        button {
            background: linear-gradient(135deg, #00b894, #00cec9);
            color: white;
            border: none;
            padding: 14px 40px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 25px;
            cursor: pointer;
            box-shadow: 0 6px 15px rgba(0,0,0,0.2);
            transition: transform 0.2s;
        }

        button:active {
            transform: scale(0.95);
        }

        /* Map Screen */
        #map-screen {
            background: #f1f2f6;
        }

        .map-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            background: white;
            padding: 8px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }

        .scrollable-map {
            flex: 1;
            overflow-y: auto;
            background: linear-gradient(to bottom, #74b9ff, #a29bfe, #ffeaa7, #ff7675);
            border-radius: 12px;
            padding: 20px 10px;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
            align-content: start;
        }

        .map-level-btn {
            aspect-ratio: 1;
            border-radius: 50%;
            background: #dfe6e9;
            color: #636e72;
            border: 3px solid #b2bec3;
            font-weight: bold;
            font-size: 14px;
            display: flex;
            justify-content: center;
            align-items: center;
            cursor: not-allowed;
            position: relative;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }

        .map-level-btn.unlocked {
            background: radial-gradient(circle, #ffeaa7, #fdcb6e);
            color: #d63031;
            border: 3px solid #e17055;
            cursor: pointer;
        }

        .map-level-btn.current {
            background: radial-gradient(circle, #fab1a0, #ff7675);
            color: white;
            border: 3px solid #d63031;
            animation: pulse 1.5s infinite;
        }

        .map-level-btn.cleared::after {
            content: "⭐";
            position: absolute;
            top: -6px;
            right: -4px;
            font-size: 12px;
        }

        /* Match-3 Board Area */
        #board-wrapper {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #dfe6e9;
            border-radius: 12px;
            padding: 8px;
            margin-bottom: 8px;
        }

        #grid {
            display: grid;
            grid-template-columns: repeat(6, 1fr);
            grid-template-rows: repeat(6, 1fr);
            gap: 4px;
            width: 100%;
            aspect-ratio: 1;
        }

        .tile {
            background: white;
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 28px;
            cursor: pointer;
            transition: transform 0.15s, background-color 0.2s;
            box-shadow: inset 0 -3px 5px rgba(0,0,0,0.05);
        }

        .tile.selected {
            background-color: var(--warning);
            transform: scale(1.1);
            z-index: 5;
        }

        /* Modals and Overlays */
        .modal {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0,0,0,0.7);
            z-index: 100;
            display: none;
            justify-content: center;
            align-items: center;
            padding: 15px;
        }

        .modal-content {
            background: white;
            border-radius: 16px;
            padding: 20px;
            width: 100%;
            max-width: 410px;
            text-align: center;
            box-shadow: 0 10px 25px rgba(0,0,0,0.3);
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            max-height: 90%;
            overflow-y: auto;
        }

        .quiz-unit-badge {
            background: #6c5ce7;
            color: white;
            padding: 4px 12px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            display: inline-block;
            margin-bottom: 8px;
        }

        .quiz-title {
            font-size: 16px;
            color: #0984e3;
            margin-bottom: 12px;
            font-weight: bold;
        }

        .quiz-question {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 15px;
            line-height: 1.4;
            background: #f1f2f6;
            padding: 12px;
            border-radius: 8px;
            text-align: left;
        }

        .quiz-options {
            display: flex;
            flex-direction: column;
            gap: 8px;
            margin-bottom: 15px;
        }

        .option-btn {
            background: white;
            border: 2px solid #74b9ff;
            color: var(--dark);
            padding: 10px 14px;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 600;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s;
        }

        .option-btn:hover {
            background: #e1f5fe;
        }

        /* Spinner */
        #loading-overlay {
            background: rgba(255,255,255,0.9);
            color: var(--dark);
            font-weight: bold;
            font-size: 16px;
        }

        .spinner {
            border: 5px solid #f3f3f3;
            border-top: 5px solid #6c5ce7;
            border-radius: 50%;
            width: 45px;
            height: 45px;
            animation: spin 1s linear infinite;
            margin-bottom: 12px;
        }

        /* Animations */
        @keyframes bounce {
            0%, 100% { transform: translateY(0); }
            50% { transform: translateY(-12px); }
        }
        @keyframes pulse {
            0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(214, 48, 49, 0.7); }
            70% { transform: scale(1.05); box-shadow: 0 0 0 8px rgba(214, 48, 49, 0); }
            100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(214, 48, 49, 0); }
